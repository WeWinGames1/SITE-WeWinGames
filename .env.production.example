# Production Environment Configuration for WeWinGames
# This file shows the required configuration for production deployment

# Application Settings
APP_NAME=WeWinGames
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_KEY_HERE
APP_DEBUG=false  # CRITICAL: Must be false in production
APP_URL=https://wewingames.com

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Security
BCRYPT_ROUNDS=12

# Logging
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database (MySQL for production)
DB_CONNECTION=mysql
DB_HOST=your-mysql-host
DB_PORT=3306
DB_DATABASE=wewingames_production
DB_USERNAME=your_db_username
DB_PASSWORD=your_secure_password

# Cache, Session, Queue
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=wewingames.com
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis

# Redis Configuration
REDIS_CLIENT=phpredis
REDIS_HOST=your-redis-host
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=your-smtp-host
MAIL_PORT=587
MAIL_USERNAME=your-smtp-username
MAIL_PASSWORD=your-smtp-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@wewingames.com"
MAIL_FROM_NAME="${APP_NAME}"

# Stripe Configuration (Production Keys)
STRIPE_KEY=pk_live_YOUR_PUBLISHABLE_KEY
STRIPE_SECRET=sk_live_YOUR_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# Stripe Price IDs (Production)
SILVER_MONTHLY=price_YOUR_SILVER_MONTHLY_ID
SILVER_WEEKLY=price_YOUR_SILVER_WEEKLY_ID
SILVER_DAILY=price_YOUR_SILVER_DAILY_ID
GOLD_MONTHLY=price_YOUR_GOLD_MONTHLY_ID
GOLD_WEEKLY=price_YOUR_GOLD_WEEKLY_ID
GOLD_DAILY=price_YOUR_GOLD_DAILY_ID
PLATINUM_MONTHLY=price_YOUR_PLATINUM_MONTHLY_ID
PLATINUM_WEEKLY=price_YOUR_PLATINUM_WEEKLY_ID
PLATINUM_DAILY=price_YOUR_PLATINUM_DAILY_ID

# Cashier Configuration
CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

# Third-Party Services
SLACK_BOT_USER_OAUTH_TOKEN=your_slack_token
SLACK_BOT_USER_DEFAULT_CHANNEL=your_channel

POSTMARK_TOKEN=your_postmark_token
RESEND_KEY=your_resend_key

# Cloudflare Security (Production)
CLOUDFLARE_ENABLED=true
CLOUDFLARE_TRUSTED_PROXIES=true
CLOUDFLARE_BLOCKED_COUNTRIES=  # Comma-separated country codes if needed
CLOUDFLARE_SECURITY_ENABLED=true

# Turnstile (Bot Protection)
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
TURNSTILE_ENABLED=true

# Broadcast & Filesystem
BROADCAST_CONNECTION=redis
FILESYSTEM_DISK=local

# AWS (if using S3 for storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
VITE_APP_NAME="${APP_NAME}"