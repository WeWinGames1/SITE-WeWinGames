APP_NAME=WeWinGames
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://wewingames.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,nightwatch
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.wewingames.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
CACHE_PREFIX=wewingames_cache

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=sendgrid
#MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@em4190.wewingames.com"
MAIL_FROM_NAME="${APP_NAME}"

# SendGrid verified subdomain (e.g., em1234.yourdomain.com)
# This domain will automatically replace the domain in from addresses
MAIL_EHLO_DOMAIN=em4190.wewingames.com

# SendGrid Configuration
SENDGRID_API_KEY=
SENDGRID_MARKETING_ENABLED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Stripe Production Keys
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENDPOINT_ID=

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:admin@wewingames.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

POSTMARK_TOKEN=
RESEND_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=true

# Cloudflare API (for cache purging)
CLOUDFLARE_ENABLED=true
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# Cloudflare Settings
CLOUDFLARE_TRUSTED_PROXIES=true
CLOUDFLARE_BLOCKED_COUNTRIES=
CLOUDFLARE_SECURITY_ENABLED=true

# Google Analytics
GOOGLE_ANALYTICS_TAG_ID=
GOOGLE_TAG_MANAGER_ID=

# Reddit Pixel
REDDIT_PIXEL_ID=
REDDIT_CONVERSION_TOKEN=

# X (Twitter) Ads — pixel + conversion tracking (pixel id "qfwd8")
TWITTER_PIXEL_ID=
# Event IDs (tw-<pixel>-<code>) from X Events Manager. Browser-visible, not secret.
TWITTER_EVENT_CONTENT_VIEW=
TWITTER_EVENT_CHECKOUT_INITIATED=
TWITTER_EVENT_SIGNUP=
TWITTER_EVENT_PURCHASE=
# Conversion API — SERVER-SIDE ONLY. Never expose to browser / commit the real token.
TWITTER_CONVERSION_TOKEN=
TWITTER_API_VERSION=12

# Heatmap / session recording (Microsoft Clarity)
HEATMAP_PROVIDER=clarity
HEATMAP_ID=

# Sentry Configuration
SENTRY_LARAVEL_DSN=
SENTRY_SEND_DEFAULT_PII=true
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_ENABLE_LOGS=true

# Nightwatch Configuration
NIGHTWATCH_ENABLED=true
NIGHTWATCH_TOKEN=
NIGHTWATCH_REQUEST_SAMPLE_RATE=0.1

# Discord OAuth & Bot Configuration
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_REDIRECT_URI="${APP_URL}/auth/discord/callback"
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_INVITE_URL=

# Discord Role IDs (get from Discord Developer Mode)
# Higher tiers automatically include all lower tier roles
DISCORD_ROLE_FREE=
DISCORD_ROLE_GOLD=
DISCORD_ROLE_PLATINUM=

# Email Verification Bypass Code (for support to help users who don't receive emails)
# Leave empty or set to false to disable. Case-insensitive.
EMAIL_VERIFICATION_BYPASS_CODE=

# Spring Big Integration (Member Sync)
SPRINGBIG_ENABLED=false
# Staging: https://gamma.api.springbig.technology/pos/v1
# Production: https://production.api.springbig.technology/pos/v1
SPRINGBIG_BASE_URL=https://production.api.springbig.technology/pos/v1
SPRINGBIG_API_KEY=
SPRINGBIG_AUTH_TOKEN=

# Spring Big External Group (Segment-based, disabled by default)
SPRINGBIG_EXTERNAL_GROUP_ENABLED=false
SPRINGBIG_EXTERNAL_GROUP_BASE_URL=https://production.api.springbig.technology/general/v1
SPRINGBIG_EXTERNAL_GROUP_ID=
SPRINGBIG_SEGMENT_FREE=
SPRINGBIG_SEGMENT_SILVER=
SPRINGBIG_SEGMENT_GOLD=
SPRINGBIG_SEGMENT_PLATINUM=
SPRINGBIG_SEGMENT_CANCELED=
