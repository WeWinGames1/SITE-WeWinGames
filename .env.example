APP_NAME=WeWinGames
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.wewingames.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=sendgrid
MAIL_SCHEME=null
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SendGrid Configuration
SENDGRID_API_KEY=
# SendGrid verified subdomain (e.g., em1234.yourdomain.com)
# This domain will automatically replace the domain in from addresses
MAIL_EHLO_DOMAIN=em4190.wewingames.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Analytics
GOOGLE_ANALYTICS_TAG_ID=
GOOGLE_TAG_MANAGER_ID=

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

CASHIER_CURRENCY=usd
CASHIER_CURRENCY_LOCALE=en_US

SLACK_BOT_USER_OAUTH_TOKEN=
SLACK_BOT_USER_DEFAULT_CHANNEL=

POSTMARK_TOKEN=
RESEND_KEY=

# Web Push Notifications (VAPID)
VAPID_SUBJECT=mailto:support@wewingames.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ENABLED=false

# Cloudflare API (for cache purging)
CLOUDFLARE_ENABLED=false
CLOUDFLARE_EMAIL=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ZONE_ID=

# Cloudflare Settings
CLOUDFLARE_TRUSTED_PROXIES=false  # Set to true when behind Cloudflare proxy
CLOUDFLARE_BLOCKED_COUNTRIES=  # Comma-separated country codes (e.g., CN,RU,KP)
CLOUDFLARE_SECURITY_ENABLED=false  # Master switch for all Cloudflare security features
